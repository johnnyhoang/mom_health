# ==============================================================================
# SUPABASE AUTH & DATABASE CONFIGURATION (VITE)
# ==============================================================================
# Nhập thông tin Supabase của bạn tại đây để ứng dụng tự động kết nối:
# Lấy thông tin tại: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres?sslmode=require

